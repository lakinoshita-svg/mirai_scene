{
  "name": "mirai-scene",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "manual:build": "node scripts/buildManual.mjs",
    "release:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/packageDelivery.ps1",
    "build:shinronavi": "node scripts/buildShinronavi.mjs",
    "release:verify-initial": "node scripts/verifyInitialRelease.mjs",
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "sync:inquiry": "node scripts/syncInquiryLinks.mjs",
    "content:new": "node scripts/newCareer.mjs",
    "content:verify-drafts": "node scripts/verifyDrafts.mjs",
    "content:verify-review": "node scripts/verifyEditorialReview.mjs",
    "content:export-drafts": "node scripts/exportDraftManuscript.mjs",
    "content:package-drafts": "node scripts/packageDrafts.mjs",
    "content:audit": "node scripts/contentAudit.mjs",
    "content:export-review": "node scripts/exportReview.mjs",
    "content:benchmark": "node scripts/benchmarkCatalog.mjs",
    "content:verify": "node scripts/verifyContent.mjs",
    "release:check": "node scripts/verifyDelivery.mjs",
    "content:inventory": "node scripts/contentInventory.mjs",
    "release:content": "node scripts/buildContentDelivery.mjs",
    "release:content-zip": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/packageContent.ps1"
  },
  "dependencies": {
    "astro": "7.3.4",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.13.6",
    "parse5": "^8.0.1",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "typescript": "^6.0.3"
  }
}
