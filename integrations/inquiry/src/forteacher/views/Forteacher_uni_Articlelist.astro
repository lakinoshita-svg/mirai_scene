---
import { localPath, legacyLessonPath } from '../lib/paths';
import universityList from '../data/university_list.json';

const majors = [...universityList].sort(
  (a, b) => (a.major_order ?? 9999) - (b.major_order ?? 9999)
);

const sortGroups = (groups = []) =>
  [...groups].sort((a, b) => (a.middle_order ?? 9999) - (b.middle_order ?? 9999));

const sortLinks = (links = []) =>
  [...links].sort((a, b) => (a.minor_order ?? 9999) - (b.minor_order ?? 9999));

const getMajorLinks = (major) => {
  const groups = sortGroups(major.groups ?? []);
  const allLinks = groups.flatMap((group) => group.links ?? []);
  return sortLinks(allLinks);
};

const chunkMajors = [];
for (let i = 0; i < majors.length; i += 3) {
  chunkMajors.push(majors.slice(i, i + 3));
}
---
<style>
  .arrow_u {
    position: relative;
    display: inline-block;
    padding-left: 20px;
  }
  .arrow_u:before {
    content: '';
    width: 6px;
    height: 6px;
    border: 0;
    border-bottom: solid 1px #333;
    border-right: solid 1px #333;
    transform: rotate(45deg);
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    margin: auto;
  }
  section.scroll-mt-20{
    scroll-margin-top: 70px; /* ヘッダーの高さ分 */
  }
  .w-400{
    margin:0 auto;
    width: 200px;
  }
/* -------------------------
  /* for pc only
  --------------------------*/

  @media screen and (min-width: 768px) {
    .w-400{
      margin:0 auto;
      width: 400px;
    }
  }
</style>
<!-- 上部ジャンプ -->
<section class="mt-10 space-y-[10px] px-4 md:px-10 xl:px-20">
  <div class="grid grid-cols-1 gap-2 md:grid-cols-3">
    {majors.map((major) => (
      <a
        href={`#${major.major_slug}`}
        class="flex overflow-hidden rounded-sm border border-slate-200 bg-white"
      >
        <div class="w-[55px] flex items-center justify-center bg-blue-100 text-blue-600 p-4">
          {major.major_icon && (
            <img src={major.major_icon} alt={major.major_category} class="h-6 w-6" />
          )}
        </div>

        <div class="px-4 py-3 flex items-center flex-1">
          <p class="font-bold">{major.major_category}</p>
        </div>

        <div class="flex w-6 shrink-0 items-center justify-center pr-2 text-neutral-500">
          <span class="arrow_u"></span>
        </div>
      </a>
    ))}
  </div>
</section>


<div class="mt-10 mb-10 px-4 xl:px-20">
  <p class="text-center text-blue-700 font-bold pb-2">
    ＼分野を調べるワークシートをダウンロード／
  </p>

  <div class="flex flex-col md:flex-row justify-center items-center gap-3 w-400">
    <a
      href={localPath('pdf/worksheet_lesson.pdf')}
      download  target="_blank" rel="noopener noreferrer"
      class="flex items-center justify-center w-full md:w-[300px] text-white font-bold py-3 px-3 rounded-lg btnBlueGrade hover:opacity-90 transition"
    >
      PDF
    </a>

    <a
      href={localPath('pdf/worksheet_lesson.docx')}
      download  target="_blank" rel="noopener noreferrer"
      class="flex items-center justify-center w-full md:w-[300px] text-white font-bold py-3 px-3 rounded-lg btnBlueGrade hover:opacity-90 transition"
    >
      Word
    </a>
  </div>
</div>
<!-- 本体 -->
<div class="mt-4 px-4 md:px-10 xl:px-20">
  {chunkMajors.map((row) => (
    <div class="pt-5 grid grid-cols-1 md:grid-cols-3 gap-5 items-stretch">
      {row.map((major) => {
        const links = getMajorLinks(major);

        return (
          <section id={major.major_slug} class="scroll-mt-20 h-full">
            <div class="overflow-hidden rounded-md bg-white h-full flex flex-col">
              <div
                class="px-4 py-3 font-bold border-b flex items-center gap-2 bg-blue-100"
                style="border-bottom:1px solid #e5e7eb;"
              >
                {major.major_icon && (
                  <img
                    src={major.major_icon}
                    alt=""
                    class="w-5 h-5 shrink-0"
                  />
                )}
                <span class="text-blue-700">{major.major_category}</span>
              </div>

              <ul class="flex-1">
                {links.map((link, index) => (
                  <li>
                    <a
                      href={legacyLessonPath(link.url)}
                      class="flex items-center justify-between px-4 py-3 text-sm hover:bg-gray-50"
                      style="border-bottom:1px solid #e5e7eb;"
                    >
                      <span>{link.minor_category}</span>
                      <span class="text-blue-700 text-xl">›</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        );
      })}
    </div>
  ))}
</div>