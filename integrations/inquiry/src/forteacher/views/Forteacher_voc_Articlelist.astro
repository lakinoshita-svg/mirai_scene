<!-- 上部ジャンプ -->
<section class="mt-10 space-y-[10px] px-4 md:px-10 xl:px-20">
  <div class="grid grid-cols-1 gap-2 md:grid-cols-3">
    {majors.map((major) => (
      <a
        href={`#${major.major_slug}`}
        class="flex overflow-hidden rounded-sm border border-slate-200 bg-white"
      >
        <div class="w-[55px] flex items-center justify-center bg-blue-100 text-blue-600 p-4">
          {major.major_icon && (
            <img src={major.major_icon} alt={major.major_category} class="h-6 w-6" />
          )}
        </div>

        <div class="px-4 py-3 flex items-center flex-1">
          <p class="font-bold">{major.major_category}</p>
        </div>

        <div class="flex w-6 shrink-0 items-center justify-center pr-2 text-neutral-500">
          <span class="arrow_u"></span>
        </div>
      </a>
    ))}
  </div>
</section>

<div class="mt-10 mb-10 px-4 xl:px-20">
  <p class="text-center text-blue-700 font-bold pb-2">
    ＼分野探究のワークシートをダウンロード／
  </p>

  <div class="flex flex-col md:flex-row justify-center items-center gap-3 w-400">
    <a
      href={localPath('pdf/worksheet_lesson.pdf')}
      download  target="_blank" rel="noopener noreferrer"
      class="flex items-center justify-center w-full md:w-[300px] text-white font-bold py-3 px-3 rounded-lg btnBlueGrade hover:opacity-90 transition"
    >
      PDF
    </a>

    <a
      href={localPath('pdf/worksheet_lesson.docx')}
      download  target="_blank" rel="noopener noreferrer"
      class="flex items-center justify-center w-full md:w-[300px] text-white font-bold py-3 px-3 rounded-lg btnBlueGrade hover:opacity-90 transition"
    >
      Word
    </a>
  </div>
</div>
<div>
{majors.map((major) => (
  <section id={major.major_slug} class="pt-0 pb-8 px-4 md:px-10 xl:px-20 scroll-mt-20">
    <div class="mb-3 rounded-md border border-slate-200 bg-blue-100 px-4 py-3 text-[18px] font-bold text-neutral-800 flex items-center gap-2 text-[#156AD1]">
      {major.major_icon && (
        <img
          src={major.major_icon}
          alt=""
          class="w-5 h-5 shrink-0"
        />
      )}
      <span class="text-blue-700">{major.major_category}</span>
    </div>

    <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3">
      {major.groups.map((group) => (
        <div class="overflow-hidden rounded-md border border-slate-200 bg-white">
          <div class="border-b border-slate-200 px-4 py-3 text-[14px] font-bold text-slate-700">
            {group.middle_category}
          </div>

          <ul>
            {sortLinks(group.links).map((link, index) => (
              <li>
                <a
                  href={legacyLessonPath(link.url)}
                  class="flex items-center justify-between px-4 py-3 text-[13px] hover:bg-slate-50"
                  style="border-bottom:1px solid #e5e7eb;"
                >
                  <span>{link.minor_category}</span>
                  <span class="text-blue-700 text-xl">›</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
))}
</div>