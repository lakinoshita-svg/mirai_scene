---
import { localPath, legacyLessonPath } from '../lib/paths';
import vocationalList from '../data/vocational_list.json';

const sortGroups = (groups = []) =>
  [...groups].sort((a, b) => (a.middle_order ?? 9999) - (b.middle_order ?? 9999));

const sortLinks = (links = []) =>
  [...links].sort((a, b) => (a.minor_order ?? 9999) - (b.minor_order ?? 9999));

const groupedMajorsMap = new Map();

for (const item of vocationalList) {
  const key = item.major_category;

  if (!groupedMajorsMap.has(key)) {
    groupedMajorsMap.set(key, {
      major_category: item.major_category,
      major_slug: item.major_slug,
      major_icon: item.major_icon,
      major_order: item.major_order,
      groups: [],
    });
  }

  const current = groupedMajorsMap.get(key);
  current.groups.push(...(item.groups ?? []));
}

const majors = [...groupedMajorsMap.values()]
  .sort((a, b) => (a.major_order ?? 9999) - (b.major_order ?? 9999))
  .map((major) => ({
    ...major,
    groups: sortGroups(major.groups),
  }));
