---
import '../styles/style.css';
import '../styles/brand.css';
import '../styles/astro.css';
import { sitePath } from '../lib/paths';
interface Props { title: string; description?: string }
const { title, description = '“好き”から始まる進路選び。画像を見て選ぶ約3分の仕事体験で、小さな「気になる」を見つけよう。' } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={sitePath('favicon.svg')} />
  </head>
  <body>
    <a class="skip-link" href="#app">本文へ移動</a>
    <header class="site-header">
      <div class="brand-family">
        <a class="parent-brand" href="https://shinronavi.com/" target="_blank" rel="noopener" aria-label="進路ナビを別タブで開く">進路ナビ</a>
        <span class="brand-divider" aria-hidden="true"></span>
        <a class="brand" href={sitePath()} aria-label="ミライシーン ホーム"><span class="brand-mark" aria-hidden="true">◧</span>ミライシーン</a>
      </div>
      <a class="header-link" href={sitePath('about/')}>ミライシーンについて <span>↗</span></a>
    </header>
    <main id="app" tabindex="-1"><slot /></main>
    <footer><a href={sitePath()} class="footer-brand">ミライシーン</a><p>“好き”から始まる進路選び。今、将来を決めなくても大丈夫。</p><span>試作版 · 掲載シーンは架空の設定です</span></footer>
  </body>
</html>
