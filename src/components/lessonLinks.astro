---
import { lessonUrl, lessonLinkLabel, type Lesson } from '../lib/learningLinks';
import ActionArrow from './actionArrow.astro';
interface Props { lessons: Lesson[] }
const { lessons } = Astro.props;
---
<ul>{lessons.map(lesson => (
  <li><a data-track="lesson" data-track-id={lesson.slug} href={lessonUrl(lesson.slug)} target="_blank" rel="noopener">{lessonLinkLabel(lesson)} <ActionArrow kind="external" /></a></li>
))}</ul>
<style>
  ul{padding-left:var(--space-2);line-height:2}
  a{color:var(--brand-purple);text-decoration:underline;overflow-wrap:anywhere}
</style>
