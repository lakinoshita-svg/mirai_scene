---
import CareerCard from './careerCard.astro';
import type { Career } from '../lib/careers';
import interests from '../data/interests.json';
import { sitePath, careerPath } from '../lib/paths';
interface Props { careers: Career[]; learningId?: string; title?: string; introduction?: string }
const { careers, learningId = '', title = 'どんなことが、ちょっと気になる？', introduction } = Astro.props;
const categories = ['すべて', ...new Set(careers.map(c => c.category))];
---
    <section id="experiences" aria-labelledby="catalog-title" tabindex="-1" data-catalog data-learning={learningId} data-index-url={sitePath('catalog/index.json')} data-card-base={sitePath('catalog/cards/')}>
      <div class="catalog-title">
<h2 id="catalog-title">{title}</h2>
</div>
      {introduction && <p class="catalogIntroduction">{introduction}</p>}
      <div class="catalog-controls" hidden>
        <!-- 興味をまだ言語化できない人が先に選べるよう、カテゴリーを検索欄より前に置く。 -->
        <div class="filters interest-filters" role="group" aria-label="興味から体験を探す">
<button class="filter active" data-interest="all" aria-pressed="true">まだ分からない・いろいろ見る</button>{interests.map(t => <button class="filter" data-interest={t.id} aria-pressed="false">{t.label}</button>)}</div>
        <label class="catalog-search">キーワードで探す<input type="search" data-search placeholder="職業名・気になる言葉" maxlength="100" /></label>
        <details class="field-picker">
<summary>職業の分野からも探せます</summary>
<div class="filters" role="group" aria-label="分野で絞り込む">{categories.map((c,i) => <button class:list={['filter', {active:i===0}]} data-category-filter={c} aria-pressed={i===0?'true':'false'}>{c}</button>)}</div>
</details>
        <button class="text-link" type="button" data-clear-filters hidden>検索条件をクリア</button>
      </div>
      <p class="catalog-count" aria-live="polite">
<span data-count-label>いろいろな仕事のひと場面</span> <span data-count>{careers.length}件</span>
</p>
      <div class="grid" id="career-grid">{careers.slice(0,9).map(c => <CareerCard career={c} />)}</div>
      <p data-catalog-status role="status"></p>
      <button type="button" class="text-link" data-retry hidden>読み込みを再試行する</button>
      <noscript><p>すべての体験へのリンク：</p><ul>{careers.map(c => <li><a href={careerPath(c.slug)}>{c.name}：{c.entryTitle}</a></li>)}</ul></noscript>
      <div class="catalog-more" hidden data-more-container>
<button type="button" class="primary" data-more aria-controls="career-grid">もっとみる <span aria-hidden="true">＋</span>
</button>
<p data-visible-count aria-live="polite" aria-atomic="true">
</p>
</div>
    </section>

<style>
  #experiences{scroll-margin-top:24px}
  #experiences:focus{outline:none}
</style>
<script>import '../scripts/catalog';</script>
<style>
 .catalog-search{display:grid;gap:8px;margin:20px 0;font-weight:700}
 .catalog-search input{width:100%;box-sizing:border-box;padding:12px 16px;font:inherit;border:1px solid var(--line);border-radius:var(--radius-small)}
</style>
