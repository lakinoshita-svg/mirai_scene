---
import type { Career } from '../lib/careers';
import { careerPath, sitePath } from '../lib/paths';
import { getCardTheme } from '../lib/cardThemes';
interface Props { career: Career }
const { career: c } = Astro.props;
const theme = getCardTheme(c.cardTheme);
---
<a class="career" href={careerPath(c.slug)} data-career={c.slug} data-card-theme={c.cardTheme} data-category={c.category} data-name={c.name} style={`--card-bg:${theme.color};--card-ink:${theme.ink}`}>
  <div class="career-art">
    <img class="theme-image" src={sitePath(theme.image)} alt={theme.label} width="480" height="320" loading="lazy" />
    <span class="art-label">{c.category}</span>
  </div>
  <div class="card-body"><span class="career-role">{c.name}のひと場面</span><h3>{c.entryTitle}</h3><p>{c.description}</p></div>
</a>
<style>
  /* 共通カードは本文の高さに合わせる。矢印用の行や説明文の固定高を設けない。 */
  .career .card-body{padding:18px}
  .career .card-body p{margin:0;min-height:0}
  .career-art .theme-image{width:100%;height:100%;object-fit:contain}
  @media(max-width:650px){
    .career .career-art{min-height:0}
    .career .card-body{padding:12px}
    .career .career-role{margin-bottom:4px}
    .career .card-body h3{margin-bottom:6px}
  }
</style>
