---
import type { Career } from '../lib/careers';
import { careerPath, sitePath } from '../lib/paths';
import { getCardTheme } from '../lib/card-themes';
interface Props { career: Career }
const { career: c } = Astro.props;
const theme = getCardTheme(c.cardTheme);
---
<a class="career" href={careerPath(c.slug)} data-career={c.slug} data-interests={c.interests.join(' ')} data-category={c.category} data-name={c.name} style={`--card-bg:${theme.color};--card-ink:${theme.ink}`}>
  <div class="career-art">
    <img class="theme-image" src={sitePath(theme.image)} alt={theme.label} width="480" height="320" loading="lazy" />
    <span class="art-label">{c.category}</span>
  </div>
  <div class="card-body"><span class="career-role">{c.name}のひと場面</span><h3>{c.entryTitle}</h3><p>{c.description}</p><div class="card-bottom"><span class="card-arrow" aria-hidden="true">↗</span></div></div>
</a>
<style>
  .card-bottom{justify-content:flex-end}
  .career-art .theme-image{width:100%;height:100%;object-fit:contain}
</style>
