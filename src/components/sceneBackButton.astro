---
import ActionArrow from './actionArrow.astro';
interface Props { label?: string }
const { label = '前のシーンを読み返す' } = Astro.props;
---
<button class="sceneBack" type="button" data-previous><ActionArrow kind="back" />{label}</button>
<style>
  /* シーン途中・完了画面で同じ操作と見た目を使う。data-previousはexperience.tsとの接続。 */
  .sceneBack {
    display:inline-flex;
    align-items:center;
    gap:var(--space-1);
    min-height:48px;
    margin-bottom:var(--space-1);
    padding:var(--space-1) var(--space-2);
    background:var(--paper);
    border:1.5px solid var(--line);
    border-radius:var(--radius-scene-back);
    color:var(--ink);
    font-size:14px;
    font-weight:700;
  }
</style>
