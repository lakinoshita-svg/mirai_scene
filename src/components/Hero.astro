---
import { sitePath } from '../lib/paths';
const asset = (name: string) => sitePath(`assets/hero/${name}`);
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-stage">
    <picture class="hero-background"><source media="(max-width: 900px)" srcset={asset('background-sp.png')} /><img src={asset('background-pc.png')} alt="" width="1774" height="887" fetchpriority="high" /></picture>
    <div class="hero-copy">
      <h1 id="hero-title">「好き！」の先にある、<span>未来をのぞいてみよう。</span></h1>
      <p>まだ、やりたいことが決まっていなくても大丈夫。<br />約3分で、気になる仕事の3つのシーンを体験。<br />選んで、考えて、自分の「好き」のヒントを見つけよう。</p>
    </div>
    <div class="hero-art">
      <img class="hero-note" src={asset('note.png')} alt="好きから、きっと見つかる わたしのミライ" />
      <div class="hero-card hero-make"><img src={asset('make.png')} alt="好きなものを、つくる。" width="1440" height="1080" /></div>
      <div class="hero-card hero-support"><img src={asset('support.png')} alt="誰かの安心を、支える。" width="1440" height="1080" /></div>
      <div class="hero-card hero-convey"><img src={asset('convey.png')} alt="気持ちやアイデアを、伝える。" width="1672" height="941" /></div>
    </div>
    <div class="hero-action">
      <!-- カード画像にはリンクを付けず、CTAから体験一覧へ移動する。 -->
      <a class="hero-invitation" href="#experiences">気になる未来を、見つけてみよう。<span aria-hidden="true">↓</span></a>
      <p class="hero-meta"><span class="hero-check"><img src={asset('check-background.svg')} alt="" /><img src={asset('check.svg')} alt="" /></span>登録なしでスタート</p>
    </div>
  </div>
</section>
<style>
  .hero{container-type:inline-size;max-width:1440px;margin:0 auto}
  .hero-stage{position:relative;aspect-ratio:1440/734;isolation:isolate}
  .hero-background{position:absolute;inset:1.9% 0 0;z-index:-1;overflow:hidden}
  .hero-background img{width:100%;height:100%;object-fit:cover}
  .hero-copy{position:absolute;left:9.3%;top:26.5%;z-index:2}
  .hero-copy h1{margin:0;color:#2c243d;font-size:3.333cqw;font-weight:700;line-height:1.24;letter-spacing:0}
  .hero-copy h1 span{display:block;width:max-content;font-size:3.889cqw;background:linear-gradient(90deg,#6956d9,#a45dd8 52%,#f59a4a);background-clip:text;color:transparent}
  .hero-copy h1 span::after{display:none}
  .hero-copy p{margin:.5cqw 0 0;font-size:1.319cqw;line-height:1.68;color:#686171}
  .hero-art{position:absolute;inset:0;pointer-events:none}
  .hero-note{position:absolute;left:87%;top:7.2%;width:12.66%;height:auto;mix-blend-mode:multiply}
  .hero-card{position:absolute;display:flex;align-items:center;justify-content:center;pointer-events:none}
  .hero-card img{display:block;width:100%;height:auto}
  .hero-make{left:49%;top:3%;width:27.78%;transform:rotate(-5deg)}
  .hero-support{left:70%;top:22%;width:27.78%;transform:rotate(5deg)}
  .hero-convey{left:49%;top:55%;width:37.01%;transform:rotate(-3deg)}
  .hero-action{position:absolute;left:15.55%;top:63.9%;width:350px;max-width:100%}
  .hero-invitation{display:flex;align-items:center;justify-content:center;gap:12px;min-height:64px;padding:12px 18px;box-sizing:border-box;border-radius:999px;background:linear-gradient(145deg,#6956d9,#a45dd8 58%,#f59a4a);color:#fff;font-size:16px;font-weight:700;line-height:1.7;text-align:center;text-decoration:none;box-shadow:0 6px 18px #6956d926}
  .hero-invitation span{display:grid;place-items:center;flex-shrink:0;width:32px;height:32px;border-radius:50%;background:#fff;color:#6956d9;font-size:20px}
  .hero-invitation:hover{box-shadow:0 8px 24px #6956d94d}
  .hero-invitation:focus-visible{outline:3px solid #6956d9;outline-offset:4px}
  .hero-meta{margin:18px 0 0;display:flex;align-items:center;justify-content:center;gap:8px;white-space:nowrap;color:#686171;font-size:15px;line-height:24px}
  .hero-check{position:relative;display:grid;place-items:center;width:16px;height:16px}
  .hero-check img{position:absolute}
  @media(min-width:901px) and (max-width:1200px){.hero-action{transform:scale(.83);transform-origin:top left}}
  @media(max-width:900px){
    .hero-stage{aspect-ratio:auto;display:flex;flex-direction:column;padding:32px 24px 36px}
    .hero-background{inset:0}.hero-copy{position:relative;left:auto;top:auto}
    .hero-copy h1{font-size:clamp(25px,4.5cqw,38px);line-height:1.4}
    .hero-copy h1 span{font-size:clamp(27px,5cqw,42px)}
    .hero-copy p{font-size:14px;line-height:1.9;margin:12px 0 0;max-width:590px}
    .hero-art{position:relative;inset:auto;height:560px;width:100%;max-width:500px;margin:10px auto 0}
    .hero-note{left:auto;right:0;top:0;width:115px}
    .hero-make{left:-2%;top:0;width:62%}.hero-support{left:auto;right:-2%;top:23%;width:62%}.hero-convey{left:-2%;top:64%;width:82%}
    .hero-action{position:relative;left:auto;top:auto;width:350px;margin:18px auto 0}
    .hero-invitation{font-size:clamp(12px,3.5cqw,16px);gap:8px;padding-inline:12px}
    .hero-meta{font-size:13px;margin-top:14px}
  }
  @media(max-width:450px){.hero-art{height:400px}.hero-support{top:23%}.hero-convey{top:65%}.hero-copy h1{font-size:clamp(21px,6.4cqw,25px)}.hero-copy h1 span{font-size:clamp(23px,6.9cqw,27px)}.hero-stage{padding:24px 20px 32px}.hero-note{width:95px}.hero-action{margin-top:24px}}
</style>
