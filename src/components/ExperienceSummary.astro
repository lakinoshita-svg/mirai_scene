---
import ExperienceReflection from './ExperienceReflection.astro';
import ExperienceLearning from './ExperienceLearning.astro';
import type { Career } from '../lib/careers';
import { careerPath, sitePath } from '../lib/paths';
interface Props { career: Career; related: Career[] }
// data-summary / hidden / tabindexはexperience.tsが画面切替とフォーカス移動に使う。
// 子コンポーネント内のdata-answer・data-reflectionも同スクリプトから操作する。
const { career:c, related } = Astro.props;

---
<article class="scene-card summary-panel" data-summary hidden tabindex="-1" aria-labelledby="summary-title">
  <div class="finish-intro"><div class="finish-icon" aria-hidden="true">✦</div><span class="scene-kicker">{c.name}の{c.scenes.length}つのシーンを体験しました</span><h1 id="summary-title">「好きかも」は、<br />見つかった？</h1><p>はっきりした答えは、まだなくても大丈夫。<br />今の気持ちを、少しだけ振り返ってみよう。</p></div>
  <ExperienceReflection career={c} />
  <ExperienceLearning career={c} />
  <h2 class="question">別の「気になる」も、探してみよう。</h2><div class="next-careers">{related.map(v=><a href={careerPath(v.slug)}><span class="career-role">{v.name}</span>{v.entryTitle} ↗</a>)}</div><div class="actions"><a class="text-link" href={sitePath()}>いろいろな体験を見てみる →</a></div>
</article>
