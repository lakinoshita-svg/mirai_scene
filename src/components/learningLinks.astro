---
import { getLearningLinks, getLessons, schoolSearchUrl } from '../lib/learningLinks';
import LessonLinks from './lessonLinks.astro';
import { sitePath } from '../lib/paths';
interface Props { ids: string[] }
const { ids } = Astro.props;
const links = getLearningLinks(ids);
const lessons = getLessons(ids);
---
<div class="learning-connections">
  <a class="primary learning-action" href={schoolSearchUrl(ids)} target="_blank" rel="noopener"><span>この分野を学べる学校を探す</span><span aria-hidden="true">↗</span></a>
  <h3>この分野で学ぶことを知ろう。</h3>
  <LessonLinks lessons={lessons} />
  {/* 資料請求の説明を、教材へのリンクと分野一覧への導線の間に置く。 */}
  <slot />
  <nav aria-label="同じ分野の仕事体験"><ul>{links.map(link => <li><a href={sitePath(`explore/${link.id}/#experiences`)}>ほかの{link.label}の仕事体験を見る →</a></li>)}</ul></nav>
</div>
<style>.learning-connections{margin-block:var(--space-3)}.learning-connections h3{font-size:18px}.learning-connections ul{padding-left:var(--space-2);line-height:2}.learning-connections li a{color:var(--brand-purple);text-decoration:underline}.learning-action{margin-top:var(--space-2)}</style>
