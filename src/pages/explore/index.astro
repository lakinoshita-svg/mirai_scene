---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { learningLinks } from '../../lib/learning-links';
import { sitePath } from '../../lib/paths';
---
<SiteLayout title="学びから探究と仕事体験を探す | ミライシーン" breadcrumb="学びと体験">
  <div class="home"><h1>学びと仕事を、行き来してみよう。</h1><p>気になる分野の探究を読んだり、仕事のひと場面を体験したり。自分のペースで理解を深められます。</p>
    <div class="learning-grid">{learningLinks.map(link => <a class="scene-card" href={sitePath(`explore/${link.id}/`)}><h2>{link.label} →</h2><p>{link.description}</p></a>)}</div>
  </div>
</SiteLayout>
<style>.learning-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:20px;margin-block:32px}.learning-grid a{display:block;text-decoration:none}.learning-grid h2{font-size:20px}</style>
