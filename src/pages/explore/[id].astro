---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CareerCard from '../../components/CareerCard.astro';
import { learningLinks, lessonUrl, schoolSearchUrl } from '../../lib/learning-links';
import { getCareers } from '../../lib/careers';
import { sitePath } from '../../lib/paths';
export async function getStaticPaths() {
  const careers = await getCareers();
  return learningLinks.map(learning => ({ params: { id: learning.id }, props: { learning, careers: careers.filter(c => c.learningIds.includes(learning.id)) } }));
}
const { learning, careers } = Astro.props;
---
<SiteLayout title={`${learning.label}の探究と仕事体験 | ミライシーン`} breadcrumb={`${learning.label}の学びと体験`}>
  <div class="home exploration">
    <a href={sitePath('explore/')} class="back">← 学びの分野一覧へ</a>
    <h1>{learning.label}を、学びと体験から知ろう。</h1>
    <p>{learning.description}探究からでも、仕事体験からでも始められます。</p>
    <section class="scene-card"><h2>この分野では何を学ぶ？</h2>
      <p>進路ナビの探究教材を別タブで開きます。読んだあとは、このページで関連する仕事を体験できます。</p>
      <ul>{learning.lessons.map(lesson => <li><a href={lessonUrl(lesson.slug)} target="_blank" rel="noopener">{lesson.schoolType}：{lesson.label}の探究を読む ↗</a></li>)}</ul>
    </section>
    <section><h2>学びにつながる仕事を体験しよう。</h2><div class="career-grid">{careers.map(career => <CareerCard career={career} />)}</div>
    <p class="fine-print">関連する学びの例です。職業に必要な資格や履修課程は、学校ごとに確認してください。</p></section>
    <section class="scene-card"><h2>学べる場所を探してみよう。</h2><a class="primary" href={schoolSearchUrl([learning.id])} target="_blank" rel="noopener">{learning.label}につながる学校を探す ↗</a><p class="fine-print">検索分野：{learning.schoolFields.map(field => field.label).join('・')}</p></section>
  </div>
</SiteLayout>
<style>.exploration h1{font-size:clamp(24px,4vw,34px);line-height:1.5}.exploration section{margin-block:32px}.exploration ul{padding-left:1.3em;line-height:2.2}.exploration li a{color:#6443a5;text-decoration:underline}</style>
