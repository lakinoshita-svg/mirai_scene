---
import SiteLayout from '../layouts/SiteLayout.astro';
import CareerCatalog from '../components/CareerCatalog.astro';
import Hero from '../components/Hero.astro';
import { getCareers } from '../lib/careers';
import { sitePath } from '../lib/paths';
const careers = await getCareers();
---
<SiteLayout title="ミライシーン | “好き”から始まる進路選び">
  <noscript>
<style>[data-catalog] .career{display:block!important}</style>
</noscript>
  <div data-catalog>
<div class="home hero-breadcrumb">
    <nav class="breadcrumbs" aria-label="現在地">
<a href="https://shinronavi.com/" target="_blank" rel="noopener">進路ナビ ↗</a>
<span aria-hidden="true">/</span>
<span>ミライシーン</span>
</nav>
  </div>
<Hero />
<div class="home">
    <CareerCatalog careers={careers} />
    <section class="about-note">
<div>
<h2>体験してから、気持ちを見つめてみよう。</h2>
<p>「おもしろそう」も「ちょっと違うかも」も、大切な気づき。仕事を決める必要はありません。少し気になったら、その先の学びをのぞいてみてください。</p>
</div>
<a class="text-link" href={sitePath('about/')}>ミライシーンについて ↗</a>
</section>
  </div>
  </div>
</SiteLayout>
<script>
  import '../scripts/catalog';
</script>

<style>.hero-breadcrumb{padding-bottom:0}</style>

